# Sample Caddy configuration for DoorKing Gate Manager
#
# Replace gate.example.com with your domain (DNS A/AAAA record pointing to this host,
# ports 80 and 443 open for Let's Encrypt).
#
# Set "publicHost": "gate.example.com" in config.json (or PUBLIC_HOST=gate.example.com in Docker),
# then copy this file to /etc/caddy/Caddyfile and reload:
#   sudo systemctl reload caddy

{
	# Optional: bind only to the interface that owns your public IP.
	# default_bind 203.0.113.10

	# Use Let's Encrypt only (avoids ZeroSSL registration failures on older distro Caddy packages).
	cert_issuer acme
}

gate.example.com {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	@api path /api /api/* /.well-known/* /download /help /privacy
	handle @api {
		# Use 127.0.0.1:8080 when Caddy runs on the host (bare-metal or Docker Compose port publish),
		# or api:8080 if Caddy runs as a container on the same Docker network.
		reverse_proxy 127.0.0.1:8080 {
			# Required for live camera MJPEG streaming (disables response buffering).
			flush_interval -1
		}
	}

	# Static web-ui bundle (built from web-ui/ into /var/www/doorking-web-ui).
	handle {
		root * /var/www/doorking-web-ui
		header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json; charset=utf-8"
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
