# Sample Caddy configuration for DoorKing Gate Manager
#
# Replace gate.example.com with your domain (DNS A/AAAA record pointing to this host,
# ports 80 and 443 open for Let's Encrypt).
#
# Set "publicHost": "gate.example.com" in config.json (or PUBLIC_HOST=gate.example.com in Docker),
# then copy this file to /etc/caddy/Caddyfile and reload:
#   sudo systemctl reload caddy

{
	# Optional: bind only to the interface that owns your public IP.
	# default_bind 203.0.113.10

	# Use Let's Encrypt only (avoids ZeroSSL registration failures on older distro Caddy packages).
	cert_issuer acme
}

gate.example.com {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	# Use 127.0.0.1:8080 when Caddy runs on the host (bare-metal or Docker Compose port publish),
	# or app:8080 if Caddy runs as a container on the same Docker network.
	reverse_proxy 127.0.0.1:8080 {
		# Required for live camera MJPEG streaming (disables response buffering).
		flush_interval -1
	}
}
